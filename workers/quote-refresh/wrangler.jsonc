{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "psx-portfolio-sip-quote-refresh",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  // One trigger only: the free Workers plan allows 5 cron triggers per account. It fires every 5 minutes, every day, and
  // src/index.ts works out from the time what is due (scrapers on weekdays 09:00-16:45 PKT, funds, platform checks).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "GITHUB_REPO": "uzairbukhari/psx-portfolio",
    "APP_ENV": "production",
    "CF_ACCOUNT_ID": "78c9e0cc85767a65d0ff868ce76c6bba"
  },
  "durable_objects": { "bindings": [{ "name": "MUFAP_FETCHER", "class_name": "MufapFetch" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MufapFetch"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "psx-portfolio-sip",
      "database_id": "f72a6264-371b-49ff-89e3-20eef1ce2b19",
      "migrations_dir": "../../drizzle"
    }
  ]
}
